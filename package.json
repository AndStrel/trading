{
  "name": "@andstrel/trading-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "T-Invest analysis MCP with deterministic risk checks and isolated confirmed sandbox execution.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node ops/setup.mjs",
    "doctor": "node --import tsx ops/doctor.mjs",
    "deploy": "docker compose build telegram-service && docker compose run --rm --no-deps --entrypoint node telegram-service dist/strategy-config-preflight.js && docker compose up -d --no-build telegram-service",
    "stop": "docker compose stop telegram-service",
    "logs": "docker compose logs --tail=80 -f telegram-service",
    "status": "docker compose ps",
    "build": "tsc -p tsconfig.json && node dist/web/copy-assets.js",
    "check": "npm run typecheck && npm test && npm run test:ops-local",
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "smoke:candidate-card": "node dist/candidate-card-smoke.js",
    "smoke:strategy-bot": "node dist/strategy-bot-smoke.js",
    "smoke:catalog-source": "node dist/catalog-parity-source-smoke.js",
    "smoke:sandbox-arming": "node dist/sandbox-arming-smoke.js",
    "smoke:tinvest": "node --env-file=.env dist/smoke.js",
    "smoke:tinvest:ci": "node dist/smoke.js",
    "scan:intraday": "node --env-file=.env dist/intraday-scanner.js",
    "history:import": "node --env-file=.env dist/history-import.js",
    "history:capture:catalog": "node dist/capture-catalog-history.js",
    "research:catalog": "node --env-file=.env dist/research-catalog.js",
    "research:similar": "node --env-file=.env dist/research-similar.js",
    "backtest:replay": "node --env-file=.env dist/backtest-replay.js",
    "backtest:catalog": "node dist/backtest-catalog-parity.js",
    "backtest:replay:sweep": "node --env-file=.env dist/backtest-replay-sweep.js",
    "backtest:replay:diagnostics": "node --env-file=.env dist/backtest-replay-diagnostics.js",
    "backtest:replay:orb-rvol": "node --env-file=.env dist/backtest-orb-rvol.js",
    "backtest:replay:orb-rvol:retest": "node --env-file=.env dist/backtest-orb-rvol.js --mode retest-breadth",
    "service:telegram": "node --env-file=.env dist/telegram-service.js",
    "preflight:pilot": "node --env-file=.env dist/pilot-preflight.js",
    "test": "vitest run",
    "test:ops-local": "node --test ops/test_*.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "fflate": "0.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
