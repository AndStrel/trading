{
  "name": "@andstrel/trading-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only MCP server for T-Invest market data, portfolios and deterministic trade-risk calculations.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "smoke:tinvest": "node --env-file=.env dist/smoke.js",
    "smoke:tinvest:ci": "node dist/smoke.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
