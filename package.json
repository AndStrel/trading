{
  "name": "@andstrel/trading-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "T-Invest analysis MCP with deterministic risk checks and isolated confirmed sandbox execution.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "smoke:candidate-card": "node dist/candidate-card-smoke.js",
    "smoke:tinvest": "node --env-file=.env dist/smoke.js",
    "smoke:tinvest:ci": "node dist/smoke.js",
    "scan:intraday": "node --env-file=.env dist/intraday-scanner.js",
    "history:import": "node --env-file=.env dist/history-import.js",
    "backtest:replay": "node --env-file=.env dist/backtest-replay.js",
    "backtest:replay:sweep": "node --env-file=.env dist/backtest-replay-sweep.js",
    "backtest:replay:diagnostics": "node --env-file=.env dist/backtest-replay-diagnostics.js",
    "backtest:replay:orb-rvol": "node --env-file=.env dist/backtest-orb-rvol.js",
    "backtest:replay:orb-rvol:retest": "node --env-file=.env dist/backtest-orb-rvol.js --mode retest-breadth",
    "service:telegram": "node --env-file=.env dist/telegram-service.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "fflate": "0.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
