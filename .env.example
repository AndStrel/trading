# Create a read-only token in T-Invest and keep it only on the machine running the MCP server.
T_INVEST_TOKEN=

# Network transport. Keep fetch by default. On Ubuntu where Node rejects the Russian Trusted CA
# while system curl succeeds, set this to system-curl.
T_INVEST_TRANSPORT=fetch

# Fill these after calling list_accounts. Never commit real account IDs.
T_INVEST_INTRADAY_ACCOUNT_ID=
T_INVEST_SWING_ACCOUNT_ID=

# Trader tariff: 0.05% per operation. Expressed as a fraction, not a percentage.
T_INVEST_COMMISSION_RATE=0.0005

# Local SQLite journal. This file contains scenario history only, never the T-Invest token.
T_INVEST_JOURNAL_PATH=.trading/journal.sqlite

# Local intraday scanner. It scans only this explicit watchlist and never sends orders.
# SBER starter example: one share per lot and 0.01 RUB price step.
T_INVEST_INTRADAY_WATCHLIST='[{"instrumentId":"e6123145-9665-43e0-8413-cd61b8aa9b13","label":"SBER","lotSize":1,"priceStep":0.01}]'
T_INVEST_SCANNER_INTERVAL_SECONDS=300
T_INVEST_SCANNER_LOOKBACK_MINUTES=360
T_INVEST_SCANNER_CANDIDATE_COOLDOWN_MINUTES=30
# Separate from broker commission. Expressed as a fraction, not a percentage.
T_INVEST_SCANNER_SLIPPAGE_RATE=0.0005

# Telegram control plane. The bot is disabled until TELEGRAM_BOT_TOKEN is set.
# Leave TELEGRAM_ALLOWED_CHAT_IDS empty for the first start, send /start to the bot,
# copy the shown chat ID here, then restart the service.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLLING_TIMEOUT_SECONDS=25

# Guardrails for a 100,000 RUB account.
INTRADAY_MAX_RISK_RUB=500
INTRADAY_MAX_POSITION_RUB=50000
# Percent, not a fraction. A scenario is blocked if the live bid/ask spread is wider.
INTRADAY_MAX_SPREAD_PCT=0.3
# Percent. Larger distance between planned entry and the latest exchange price requires review.
INTRADAY_MAX_ENTRY_DEVIATION_PCT=0.5
# Keep false until paper trading and separate acceptance.
INTRADAY_ALLOW_SHORT=false

SWING_MAX_RISK_RUB=700
SWING_MAX_POSITION_RUB=50000
SWING_MAX_SPREAD_PCT=0.5
SWING_MAX_ENTRY_DEVIATION_PCT=1
SWING_ALLOW_SHORT=false
