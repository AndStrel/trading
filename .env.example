# Create a read-only token in T-Invest and keep it only on the machine running the MCP server.
T_INVEST_TOKEN=

# Network transport. Keep fetch by default. On Ubuntu where Node rejects the Russian Trusted CA
# while system curl succeeds, set this to system-curl.
T_INVEST_TRANSPORT=fetch

# Fill these after calling list_accounts. Never commit real account IDs.
T_INVEST_INTRADAY_ACCOUNT_ID=
T_INVEST_SWING_ACCOUNT_ID=

# Trader tariff: 0.05% per operation. Expressed as a fraction, not a percentage.
T_INVEST_COMMISSION_RATE=0.0005

# Local SQLite journal. This file contains scenario history only, never the T-Invest token.
T_INVEST_JOURNAL_PATH=.trading/journal.sqlite

# One-year minute-candle archives used only for reproducible historical analysis/backtests.
# They are kept separate from the scenario journal because market data can grow substantially.
T_INVEST_HISTORY_DATA_URL=https://invest-public-api.tbank.ru/history-data
T_INVEST_MARKET_DATA_PATH=.trading/market-data.sqlite

# Local intraday scanner. `moex-liquid` is the normal mode: it resolves a curated liquid
# MOEX share universe through T-Invest every 24 hours, so UID, lot and price step are never
# manually maintained in .env. The broker API has no reliable all-market liquidity ranking;
# the scanner also requires the actual rolling 5-minute turnover below before it reads a book.
T_INVEST_INTRADAY_UNIVERSE=moex-liquid
# Optional comma-separated override of the curated tickers, for example: SBER,GAZP,LKOH
T_INVEST_INTRADAY_UNIVERSE_TICKERS=
T_INVEST_SCANNER_UNIVERSE_REFRESH_MINUTES=1440
T_INVEST_SCANNER_MAX_INSTRUMENTS=30
# Prevent bursts to T-Invest. With the default 26 instruments this is roughly 5–6 candle
# requests per minute plus market-context calls only for strong preliminary signals.
T_INVEST_SCANNER_MAX_CONCURRENT_REQUESTS=2
# RUB turnover per completed 5-minute candle, averaged over the previous 20 candles.
T_INVEST_SCANNER_MIN_AVERAGE_CANDLE_TURNOVER_RUB=1000000
T_INVEST_SCANNER_MAX_CANDIDATES_PER_SCAN=3

# Legacy compatibility only. Use this mode only for a deliberate one-instrument experiment:
# T_INVEST_INTRADAY_UNIVERSE=watchlist
T_INVEST_INTRADAY_WATCHLIST='[]'
T_INVEST_SCANNER_INTERVAL_SECONDS=300
T_INVEST_SCANNER_LOOKBACK_MINUTES=360
T_INVEST_SCANNER_CANDIDATE_COOLDOWN_MINUTES=30
# Separate from broker commission. Expressed as a fraction, not a percentage.
T_INVEST_SCANNER_SLIPPAGE_RATE=0.0005

# Telegram control plane. The bot is disabled until TELEGRAM_BOT_TOKEN is set.
# Leave TELEGRAM_ALLOWED_CHAT_IDS empty for the first start, send /start to the bot,
# copy the shown chat ID here, then restart the service.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLLING_TIMEOUT_SECONDS=25

# Isolated order execution. Keep disabled until the sandbox verification step.
# This must be a separate token with trading permissions; never reuse it as T_INVEST_TOKEN.
T_INVEST_EXECUTION_MODE=disabled
T_INVEST_TRADING_TOKEN=
# Optional. If empty, /execution_arm SANDBOX creates and stores a dedicated sandbox account.
T_INVEST_SANDBOX_ACCOUNT_ID=
T_INVEST_SANDBOX_INITIAL_BALANCE_RUB=100000
T_INVEST_EXECUTION_MAX_ORDERS_PER_DAY=3
T_INVEST_EXECUTION_MAX_DAILY_RISK_RUB=1000
T_INVEST_EXECUTION_CANDIDATE_MAX_AGE_MINUTES=10

# Historical replay only. This virtual capital is independent of both brokerage and sandbox
# accounts; it limits the portfolio simulator to cash-only positions.
T_INVEST_BACKTEST_STARTING_CAPITAL_RUB=100000
T_INVEST_BACKTEST_MAX_CONCURRENT_POSITIONS=2

# Guardrails for a 100,000 RUB account.
INTRADAY_MAX_RISK_RUB=500
INTRADAY_MAX_POSITION_RUB=50000
# Percent, not a fraction. A scenario is blocked if the live bid/ask spread is wider.
INTRADAY_MAX_SPREAD_PCT=0.3
# Percent. Larger distance between planned entry and the latest exchange price requires review.
INTRADAY_MAX_ENTRY_DEVIATION_PCT=0.5
# Keep false until paper trading and separate acceptance.
INTRADAY_ALLOW_SHORT=false

SWING_MAX_RISK_RUB=700
SWING_MAX_POSITION_RUB=50000
SWING_MAX_SPREAD_PCT=0.5
SWING_MAX_ENTRY_DEVIATION_PCT=1
SWING_ALLOW_SHORT=false
